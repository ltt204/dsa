    {
      "id": "frQuDmGHaDNR_hEPEoKoE",
      "type": "text",
      "x": 7070.262205544645,
      "y": 19693.39780320972,
      "width": 1495.4220241712878,
      "height": 360,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bTN",
      "roundness": null,
      "seed": 48389494,
      "version": 858,
      "versionNonce": 1390316475,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789802555487,
      "created": 1789649768555,
      "link": null,
      "locked": false,
      "text": "At index 0, we have 1 option is robbed\nBut at index 1, we can see we have two option:\n    1. Not rob the index 0, and robbed the current house\n    2. Skip current hourse\nIf we take the current house, we can add the value the nearest not adjacent\nhourse. Since we already calculated from the very first, the add will also contains\nthose very first house - accumulate and using max will help us find the max at the\ncurrent house",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "At index 0, we have 1 option is robbed\nBut at index 1, we can see we have two option:\n    1. Not rob the index 0, and robbed the current house\n    2. Skip current hourse\nIf we take the current house, we can add the value the nearest not adjacent hourse. Since we already calculated from the very first, the add will also contains those very first house - accumulate and using max will help us find the max at the current house",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
