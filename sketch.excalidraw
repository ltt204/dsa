      "seed": 756209177,
      "version": 963,
      "versionNonce": 1317081849,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789518811631,
      "created": 1789518809012,
      "link": null,
      "locked": false,
      "text": "Idea: Still backtracking. Using a for\nloop, backtrack consecutively with i.\nSince a value can be pick up unlimitedly,\nwe have the put the gate for checking\nif the sum is greater that the target\nor not to prevent infinite loop at the\nsame element.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Idea: Still backtracking. Using a for loop, backtrack consecutively with i.\nSince a value can be pick up unlimitedly, we have the put the gate for checking if the sum is greater that the target or not to prevent infinite loop at the same element.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
