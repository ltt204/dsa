    {
      "id": "Y-tBKY-6CCKGjJhvE2EsX",
      "type": "text",
      "x": 1808.5258582584647,
      "y": 16430.12539407498,
      "width": 696.5814408448736,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bC1",
      "roundness": null,
      "seed": 1614685628,
      "version": 865,
      "versionNonce": 1176721028,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789480404546,
      "created": 1789479168194,
      "link": null,
      "locked": false,
      "text": "Idea: Still backtracking. Using a for\nloop, backtrack consecutively with i.\nSince a value can be pick up unlimitedly,\nwe have the put the gate for checking\nif the sum is greater that the target\nor not to prevent infinite loop at the\nsame element.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Idea: Still backtracking. Using a for loop, backtrack consecutively with i.\nSince a value can be pick up unlimitedly, we have the put the gate for checking if the sum is greater that the target or not to prevent infinite loop at the same element.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
