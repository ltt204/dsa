    {
      "id": "qFehPeuwTN9GWDZQ1xrrF",
      "type": "text",
      "x": 12674.751142921123,
      "y": 16659.553732305747,
      "width": 368.6041259765625,
      "height": 45,
      "angle": 0,
      "strokeColor": "#2f9e44",
