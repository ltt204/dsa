    {
      "id": "ggb0X5fK_0Qw4-86GeMOK",
      "type": "text",
      "x": 1800.126435217287,
      "y": 17361.590663418283,
      "width": 696.5814408448736,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCP",
